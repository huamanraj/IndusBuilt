{
  "version": 1,
  "hooks": {
    "SubagentStart": [
      {
        "name": "subagent-tracker-start",
        "event": "SubagentStart",
        "type": "command",
        "command": "echo {\"decision\": \"allow\", \"system_message\": \"Subagent dispatched\"}",
        "timeout": 10
      }
    ],
    "SubagentStop": [
      {
        "name": "subagent-tracker-stop",
        "event": "SubagentStop",
        "type": "command",
        "command": "echo {\"decision\": \"allow\", \"system_message\": \"Subagent completed successfully\"}",
        "timeout": 10
      }
    ]
  }
}